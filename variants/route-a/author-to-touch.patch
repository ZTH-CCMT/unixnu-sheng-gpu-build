+}
+
+int nvt_touch_process(struct nvt_touch_core *core,const int16_t *matrix,unsigned frame_type,
+                      struct nvt_contact *out,int max) {
+    core->timed_enabled=0;
+    return process_matrix(core,matrix,frame_type,out,max);
+}
