new file mode 100644
--- /dev/null
+++ b/device/drivers/ShengHidInput/NativeHidTouchPlan.h
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Pure report planning/ACK bookkeeping. No allocation, timer, I/O or OS ABI.
+#ifndef NATIVE_HID_TOUCH_PLAN_H
+#define NATIVE_HID_TOUCH_PLAN_H
+#include <stdint.h>
+#include <string.h>
+#define NHT_CONTACTS 10
+#define NHT_REPORT_BYTES (1+NHT_CONTACTS*6+1)
+struct nht_point {int id,x,y;}; // Already normalized0..32767; IDs0..255.
+struct nht_state {uint32_t sequence;unsigned count;struct nht_point point[NHT_CONTACTS];};
+struct nht_packet {unsigned char bytes[NHT_REPORT_BYTES];unsigned entries,downs,ups;struct nht_state acknowledged;};
+struct nht_plan {uint32_t sequence;unsigned count,next;struct nht_packet packet[2];};
+static inline int nht_index(const struct nht_point *p,unsigned count,int id) {for(unsigned i=0;i<count;++i)if(p[i].id==id)return (int)i;return -1;}
+static inline int nht_valid(const struct nht_point *p,unsigned count) {
+ if(count>NHT_CONTACTS || (count && !p))return 0;
+ for(unsigned i=0;i<count;++i)if(p[i].id<0 || p[i].id>255 || p[i].x<0 || p[i].x>32767 || p[i].y<0 || p[i].y>32767 || nht_index(p,i,p[i].id)>=0)return 0;
+ return 1;
+}
+static inline void nht_entry(struct nht_packet *q,const struct nht_point *p,int down) {
+ unsigned char *f=q->bytes+1+q->entries*6;f[0]=(unsigned char)(down?3:2);f[1]=(unsigned char)p->id;
+ f[2]=(unsigned char)p->x;f[3]=(unsigned char)(p->x>>8);f[4]=(unsigned char)p->y;f[5]=(unsigned char)(p->y>>8);
+ ++q->entries;if(down)q->acknowledged.point[q->acknowledged.count++]=*p,++q->downs;else ++q->ups;
+}
+// Returns packetcount0..2, or-1 for invalid input. Input/ack state never mutated.
+// If no packets are needed, caller may commit the empty snapshot's sequence.
+static inline int nht_build(const struct nht_state *ack,const struct nht_point *now,unsigned count,uint32_t sequence,struct nht_plan *plan) {
+ if(!ack || !plan || (sequence&1) || !nht_valid(ack->point,ack->count) || !nht_valid(now,count))return -1;
+ memset(plan,0,sizeof(*plan));plan->sequence=sequence;
+ if(sequence==ack->sequence)return 0;
+ unsigned removed=0;for(unsigned j=0;j<ack->count;++j)if(nht_index(now,count,ack->point[j].id)<0)++removed;
+ if(!count && !removed)return 0;
+ struct nht_packet *first=&plan->packet[0];first->bytes[0]=3;first->acknowledged.sequence=ack->sequence;
+ if(count+removed>NHT_CONTACTS) {
+  // Phase1: only old survivors DOWN plus every vanished old ID UP. Exactly the
+  // old set (<=10) fits. Do not admit new DOWN until the old UP packet succeeds.
+  for(unsigned i=0;i<count;++i)if(nht_index(ack->point,ack->count,now[i].id)>=0)nht_entry(first,&now[i],1);
+  for(unsigned j=0;j<ack->count;++j)if(nht_index(now,count,ack->point[j].id)<0)nht_entry(first,&ack->point[j],0);
+  struct nht_packet *second=&plan->packet[1];second->bytes[0]=3;second->acknowledged.sequence=sequence;
+  for(unsigned i=0;i<count;++i)nht_entry(second,&now[i],1);
+  plan->count=2;
+ } else {
+  for(unsigned i=0;i<count;++i)nht_entry(first,&now[i],1);
+  for(unsigned j=0;j<ack->count;++j)if(nht_index(now,count,ack->point[j].id)<0)nht_entry(first,&ack->point[j],0);
+  first->acknowledged.sequence=sequence;plan->count=1;
+ }
+ for(unsigned i=0;i<plan->count;++i)plan->packet[i].bytes[NHT_REPORT_BYTES-1]=(unsigned char)plan->packet[i].entries;
+ return (int)plan->count;
+}
+// API success acknowledges submission, not delivery to backboardd/UIKit. Errors
+// may be ambiguous; this stores successful API reports only, never exactly-once.
+// A caller may rebuild from this state at its next notification after failure.
+static inline int nht_commit(struct nht_state *ack,struct nht_plan *plan,unsigned index,int report_success) {
+ if(!ack || !plan || index!=plan->next || index>=plan->count || !report_success)return 0;
+ *ack=plan->packet[index].acknowledged;++plan->next;return 1;
+}
+#endif
diff --git a/device/drivers/ShengNovatekTouch/NvtPartialObservation.c b/device/drivers/ShengNovatekTouch/NvtPartialObservation.c
new file mode 100644
--- /dev/null
+++ b/device/drivers/ShengNovatekTouch/NvtPartialObservation.c
@@ -0,0 +1,373 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "NvtPartialObservation.h"
+#include "NvtProtocol.h"
+#include <string.h>
+
+/* Numerical budgets are deliberately explicit, not physical calibration.
+ * Template: raw measured M, 9x9. Search: <=4 nodes from last actual position.
+ * Gaussian shape is learned from full-M moments and verified against that M.
+ * Shape parameters are never supplied by a host/oracle in production.
+ * This is bounded integer coordinate descent, not SciPy/IRLS source port. */
+#define PM_Q 256
+#define PM_ONE 4096
+#define PM_MAX_DELTA 8192
+#define PM_MAX_OFFSET (4*PM_Q)
+#define PM_HUBER 12
+#define PM_MAX_AMP_Q12 (8*PM_ONE)
+#define PM_MIN_AMP_Q12 (PM_ONE/8)
+#define PM_MARGIN 4
+
+static int absi(int v) {return v<0?-v:v;}
+static int mini(int a,int b) {return a<b?a:b;}
+static int maxi(int a,int b) {return a>b?a:b;}
+static int floor_q8(int v) {return v>=0?v/256:-((-v+255)/256);}
+static int divide_round(int64_t n,int64_t d) {
+    return (int)(n>=0?(n+d/2)/d:-((-n+d/2)/d));
+}
+static int axis_at_q8(int value,int rows) {
+    const int count=rows?NVT_ROWS:NVT_COLUMNS;
+    int index=floor_q8(value), f=value-index*256;
+    if(index<0)return (rows?nvt_touch_row_center(0):nvt_touch_column_center(0))*10;
+    if(index>=count-1)return (rows?nvt_touch_row_center(count-1):nvt_touch_column_center(count-1))*10;
+    const int a=rows?nvt_touch_row_center(index):nvt_touch_column_center(index);
+    const int b=rows?nvt_touch_row_center(index+1):nvt_touch_column_center(index+1);
+    return a*10+divide_round((int64_t)(b-a)*10*f,256);
+}
+static int map_q8(int value,int rows) {
+    return nvt_touch_map_edge_axis(axis_at_q8(value,rows),
+           rows?NVT_SHORT_AXIS_MAX:NVT_LONG_AXIS_MAX,rows);
+}
+static int inverse_axis(int coordinate,int rows) {
+    int low=0, high=((rows?NVT_ROWS:NVT_COLUMNS)-1)*256;
+    while(low<high) {
+        const int mid=low+(high-low)/2;
+        if(map_q8(mid,rows)<coordinate)low=mid+1;else high=mid;
+    }
+    return low;
+}
+static int slot_current(const struct nvt_partial_template *t,
+                        const struct nvt_slot *slot) {
+    return t->valid && slot->active && slot->age>=2 &&
+           t->tracking_id==slot->tracking_id &&
+           t->generation==slot->generation && t->born_us==slot->born_us;
+}
+void nvt_partial_reset(struct nvt_partial_state *s) {if(s)memset(s,0,sizeof(*s));}
+static int seed_model_valid(struct nvt_partial_state *,struct nvt_partial_template *,
+                            const struct nvt_touch_core *,const int16_t *);
+static int isolated(const struct nvt_touch_core *core,int which,int row,int col) {
+    for(int i=0;i<NVT_SLOTS;++i) {
+        const struct nvt_slot *other=&core->slots[i];
+        if(i==which || !other->active)continue;
+        const int r=inverse_axis(other->y,1), c=inverse_axis(other->x,0);
+        /* Shared support cannot be independently explained twice. Until joint
+         * template fitting is available, reject overlapping local ROIs. */
+        if(absi(r-row)<8*PM_Q && absi(c-col)<8*PM_Q)return 0;
+    }
+    return 1;
+}
+void nvt_partial_seed(struct nvt_partial_state *s,
+                      const struct nvt_touch_core *core,
+                      const int16_t *matrix,uint64_t now_us) {
+    if(!s || !core || !matrix || !core->have_reference)return;
+    for(int i=0;i<NVT_SLOTS;++i) {
+        const struct nvt_slot *slot=&core->slots[i];
+        struct nvt_partial_template *t=&s->finger[i];
+        if(!slot_current(t,slot))t->valid=0;
+        if(!slot->active || slot->age<2 ||
+           slot->last_observed_us!=now_us)continue;
+        const int row=inverse_axis(slot->y,1), col=inverse_axis(slot->x,0);
+        const int ar=(row+128)/256, ac=(col+128)/256;
+        if(ar<PM_MARGIN || ac<PM_MARGIN ||
+           ar+PM_MARGIN>=NVT_ROWS || ac+PM_MARGIN>=NVT_COLUMNS ||
+           !isolated(core,i,row,col))continue;
+        int peak=0, support=0, minr=9,maxr=-1,minc=9,maxc=-1, edge=0;
+        for(int r=-4;r<=4;++r)for(int c=-4;c<=4;++c) {
+            const int node=(ar+r)*NVT_COLUMNS+ac+c;
+            const int d=(int)matrix[node]-core->reference[node];
+            if(d>peak)peak=d;
+            if(d>=NVT_UP_THRESHOLD) {
+                ++support;
+                if(r<minr)minr=r;if(r>maxr)maxr=r;
+                if(c<minc)minc=c;if(c>maxc)maxc=c;
+            }
+            if((r==-4 || r==4 || c==-4 || c==4) && d>edge)edge=d;
+        }
+        if(peak<NVT_DOWN_THRESHOLD || peak>PM_MAX_DELTA ||
+           support<3 || support>=NVT_PALM_MIN_NODES ||
+           minr==maxr || minc==maxc || edge*5>peak)continue;
+        int border[32],nb=0;
+        for(int r=-4;r<=4;++r)for(int c=-4;c<=4;++c)
+            if(r==-4 || r==4 || c==-4 || c==4)
+                border[nb++]=(int)matrix[(ar+r)*NVT_COLUMNS+ac+c]-core->reference[(ar+r)*NVT_COLUMNS+ac+c];
+        for(int j=1;j<nb;++j){int v=border[j],k=j;while(k && border[k-1]>v){border[k]=border[k-1];--k;}border[k]=v;}
+        const int background=(border[15]+border[16])/2;
+        int64_t mass=0,sr=0,sc=0;
+        for(int r=-4;r<=4;++r)for(int c=-4;c<=4;++c) {
+            const int node=(ar+r)*NVT_COLUMNS+ac+c;
+            const int d=(int)matrix[node]-core->reference[node]-background;
+            mass+=d;sr+=(int64_t)d*r*256;sc+=(int64_t)d*c*256;
+        }
+        if(mass<=0)continue;
+        const int center_r=divide_round(sr,mass),center_c=divide_round(sc,mass);
+        if(absi(center_r)>256 || absi(center_c)>256)continue;
+        int64_t vr=0,vc=0,cov=0;
+        for(int r=-4;r<=4;++r)for(int c=-4;c<=4;++c) {
+            const int node=(ar+r)*NVT_COLUMNS+ac+c;
+            const int d=(int)matrix[node]-core->reference[node]-background;
+            const int rr=r*256-center_r,cc=c*256-center_c;
+            vr+=(int64_t)d*rr*rr;vc+=(int64_t)d*cc*cc;cov+=(int64_t)d*rr*cc;
+        }
+        const int varr=divide_round(vr,mass),varc=divide_round(vc,mass),covrc=divide_round(cov,mass);
+        if(varr<16384 || varc<16384 || varr>262144 || varc>262144 ||
+           (int64_t)varr*varc-(int64_t)covrc*covrc<(int64_t)(varr+varc)*4096)continue;
+        const struct nvt_partial_template old=*t;
+        t->variance_x_q16=varc;t->variance_y_q16=varr;t->covariance_xy_q16=covrc;
+        t->valid=1;t->tracking_id=slot->tracking_id;
+        t->generation=slot->generation;t->born_us=slot->born_us;
+        t->seed_us=now_us;t->origin_row_q8=ar*256+center_r;t->origin_col_q8=ac*256+center_c;
+        t->anchor_row=ar;t->anchor_col=ac;t->seed_peak=peak;t->support=support;
+        for(int r=-4;r<=4;++r)for(int c=-4;c<=4;++c) {
+            const int node=(ar+r)*NVT_COLUMNS+ac+c;
+            int d=(int)matrix[node]-core->reference[node];
+            d=maxi(0,mini(d,peak));
+            t->values[(r+4)*9+c+4]=(int16_t)divide_round((int64_t)d*1024,peak);
+        }
+        if(!seed_model_valid(s,t,core,matrix)){*t=old;continue;}
+        ++s->seeded;
+    }
+}
+/* exp(-x) in Q10, using ten bounded Q30 squarings:
+ * (1-x/1024)^1024. For x<=16 the maximum relative approximation error
+ * near a strong useful node is small and full-M residual validation includes it.
+ * No runtime floating point, libm or table generated from a test oracle. */
+static int template_at(const struct nvt_partial_template *t,int rowq,int colq) {
+    const int64_t dx=colq-t->origin_col_q8,dy=rowq-t->origin_row_q8;
+    if(dx>2048 || dx< -2048 || dy>2048 || dy< -2048)return 0;
+    const int64_t det=(int64_t)t->variance_x_q16*t->variance_y_q16-
+                       (int64_t)t->covariance_xy_q16*t->covariance_xy_q16;
+    if(det<=0)return 0;
+    const int64_t numerator=t->variance_y_q16*dx*dx-
+            2*(int64_t)t->covariance_xy_q16*dx*dy+t->variance_x_q16*dy*dy;
+    if(numerator<0)return 0;
+    const int64_t exponent_q20=numerator*524288/det;
+    if(exponent_q20>=16*1048576)return 0;
+    int64_t value=INT64_C(1073741824)-exponent_q20;
+    for(int i=0;i<10;++i)value=(value*value+INT64_C(536870912))/INT64_C(1073741824);
+    return (int)((value+524288)/1048576);
+}
+struct fit_result {int dx,dy,amp,bg,rms_q8,peak,information,one_axis_valid; int64_t cost; int valid;};
+static int model_k(const struct nvt_partial_template *t,
+                    const struct nvt_partial_sample *p,int dx,int dy) {
+    return template_at(t,p->row*256-dy,p->col*256-dx);
+}
+static struct fit_result fit_at(struct nvt_partial_state *s,
+               const struct nvt_partial_template *t,int count,int dx,int dy) {
+    struct fit_result result;
+    memset(&result,0,sizeof(result));result.dx=dx;result.dy=dy;
+    result.cost=INT64_MAX;
+    for(int j=0;j<count;++j)s->model[j]=(int16_t)model_k(t,&s->sample[j],dx,dy);
+    int amp=PM_ONE,bg=0;
+    for(int pass=0;pass<3;++pass) {
+        int64_t sw=0,sk=0,sd=0,skk=0,skd=0;
+        for(int j=0;j<count;++j) {
+            const int k=s->model[j],d=s->sample[j].delta;
+            int w=16;
+            if(pass) {
+                const int e=absi(divide_round((int64_t)amp*k,PM_ONE)+bg-d);
+                if(e>PM_HUBER)w=(PM_HUBER*16+e/2)/e;
+            }
+            s->sample[j].weight=(uint16_t)w;
+            sw+=w;sk+=(int64_t)w*k;sd+=(int64_t)w*d;
+            skk+=(int64_t)w*k*k;skd+=(int64_t)w*k*d;
+        }
+        const int64_t den=sw*skk-sk*sk,num=sw*skd-sk*sd;
+        if(den<=0 || num<=0 || num>den*8)return result;
+        amp=divide_round(num*PM_ONE,den);
+        if(amp<=PM_MIN_AMP_Q12 || amp>=PM_MAX_AMP_Q12)return result;
+        bg=divide_round(sd*PM_ONE-(int64_t)amp*sk,sw*PM_ONE);
+        if(bg<=-100 || bg>=100)return result;
+    }
+    int64_t cost=0,squares=0;
+    int peak=0;
+    for(int j=0;j<count;++j) {
+        const int k=s->model[j];
+        const int e=divide_round((int64_t)amp*k,PM_ONE)+bg-s->sample[j].delta;
+        const int ae=absi(e);
+        cost+=ae<=PM_HUBER?(int64_t)e*e:(int64_t)PM_HUBER*(2*ae-PM_HUBER);
+        squares+=(int64_t)e*e;
+        if(s->sample[j].delta-bg>peak)peak=s->sample[j].delta-bg;
+    }
+    result.amp=amp;result.bg=bg;result.cost=cost;result.peak=peak;
+    /* Store mean square *256 instead of using sqrt/libm in kernel. */
+    const int64_t mean_square_q8=squares*256/count;
+    result.rms_q8=(int)(mean_square_q8>INT32_MAX?INT32_MAX:mean_square_q8);
+    result.valid=1;
+    return result;
+}
+static int information_ok(struct nvt_partial_state *s,
+             const struct nvt_partial_template *t,int count,
+             struct fit_result *f) {
+    int64_t sw=0,sk=0,sx=0,sy=0,kk=0,xx=0,yy=0,xy=0,xk=0,yk=0;
+    /* Derivatives are ADC/node scaled1/32; full template K is preserved.
+     * Shape eigenvalue lower bound>=1/16node² and amp<8 bound |g|<640.
+     * count<=121,w<=16,K<=1024 keep all moments/Schur products signed64.
+     * Quantized Huber weights have1/16resolution; very large outliers can get
+     * zero weight. Unweighted residual admission is still independently used. */
+    for(int j=0;j<count;++j) {
+        struct nvt_partial_sample *p=&s->sample[j];
+        const int k=model_k(t,p,f->dx,f->dy);
+        const int e=absi(divide_round((int64_t)f->amp*k,PM_ONE)+f->bg-p->delta);
+        const int w=e>PM_HUBER?(PM_HUBER*16+e/2)/e:16;
+        p->weight=(uint16_t)w;
+        const int gx=divide_round((int64_t)f->amp*
+           (model_k(t,p,f->dx+16,f->dy)-model_k(t,p,f->dx-16,f->dy)),PM_ONE*4);
+        const int gy=divide_round((int64_t)f->amp*
+           (model_k(t,p,f->dx,f->dy+16)-model_k(t,p,f->dx,f->dy-16)),PM_ONE*4);
+        if(absi(gx)>=640 || absi(gy)>=640)return 0;
+        sw+=w;sk+=(int64_t)w*k;sx+=(int64_t)w*gx;sy+=(int64_t)w*gy;
+        kk+=(int64_t)w*k*k;xx+=(int64_t)w*gx*gx;yy+=(int64_t)w*gy*gy;
+        xy+=(int64_t)w*gx*gy;xk+=(int64_t)w*gx*k;yk+=(int64_t)w*gy*k;
+    }
+    if(sw<8)return 0;
+    /* Weighted raw moments eliminate background without rounding the means.
+     * A conservative tiny curvature allowance below covers integer divisions. */
+    kk-=sk*sk/sw;xx-=sx*sx/sw;yy-=sy*sy/sw;
+    xy-=sx*sy/sw;xk-=sx*sk/sw;yk-=sy*sk/sw;
+    if(kk<=0)return 0;
+    xx-=xk*xk/kk;yy-=yk*yk/kk;xy-=xk*yk/kk;
+    /* det/trace is a positive lower bound on lambda_min for every SPD2x2,
+     * including rotated correlated shapes that fail diagonal dominance.
+     * Scale before products and subtract quantization curvature conservatively. */
+    int64_t ax=xx,ay=yy,axy=xy,scale=1;
+    while(ax>100000000 || ay>100000000 || axy>100000000 || axy< -100000000) {
+        ax/=2;ay/=2;axy/=2;scale*=2;
+    }
+    const int64_t trace=ax+ay,det=ax*ay-axy*axy;
+    int64_t lower=0;
+    if(ax>0 && ay>0 && det>0 && trace>0)lower=(det/trace-4)*scale;
+    const int64_t sigma2=maxi(4,(f->rms_q8+255)/256);
+    /* Non2D information can be recorded but never becomes a position lease.
+     * trace/2 lower-bounds the strongest eigenvalue of a PSD matrix. */
+    const int64_t strongest=(xx+yy)/2;
+    f->one_axis_valid=strongest>0 && sigma2*90000<strongest*4096;
+    f->information=lower>0?(int)(lower>INT32_MAX?INT32_MAX:lower):0;
+    /* gradient1/32, weights<=16 -> information factor64.
+     * 3sigma<=0.08node => 90000*sigma² <4096*lambda_min_bound.
+     * This local GN estimate is not calibrated physical confidence. */
+    return lower>0 && sigma2*90000<lower*4096;
+}
+static int seed_model_valid(struct nvt_partial_state *s,
+        struct nvt_partial_template *t,const struct nvt_touch_core *core,
+        const int16_t *matrix) {
+    int count=0;
+    for(int r=-4;r<=4;++r)for(int c=-4;c<=4;++c) {
+        const int row=t->anchor_row+r,col=t->anchor_col+c;
+        const int node=row*NVT_COLUMNS+col;
+        struct nvt_partial_sample *p=&s->sample[count++];
+        p->row=(int16_t)row;p->col=(int16_t)col;
+        p->delta=(int16_t)((int)matrix[node]-core->reference[node]);p->weight=16;
+    }
+    struct fit_result fit=fit_at(s,t,count,0,0);
+    t->seed_mse_q8=fit.rms_q8;
+    /* A non-Gaussian M shape must not enter the PM model. The one-percent
+     * model residual budget is separate from the noise information estimate. */
+    const int budget=maxi(6,t->seed_peak/100);
+    return fit.valid && fit.rms_q8<=budget*budget*256 &&
+           information_ok(s,t,count,&fit);
+}
+int nvt_partial_measure(struct nvt_partial_state *s,
+                        const struct nvt_touch_core *core,
+                        const uint8_t *raw,size_t length,uint64_t now_us,
+                        struct nvt_contact *out,int max) {
+    if(!s || !core || !raw || !out || max<0)return -1;
+    s->presence_ids=0;s->one_axis_ids=0;
+    s->last_reason=NVT_PM_BAD_PACKET;
+    if(length!=NVT_THP_FRAME_LEN || !nvt_frame_header_valid(raw) ||
+       !nvt_frame_is_stylus(raw) ||
+       (nvt_frame_type(raw)!=2 && nvt_frame_type(raw)!=4) ||
+       raw[332]<1 || raw[332]>4) {
+        ++s->rejected[NVT_PM_BAD_PACKET];return -1;
+    }
+    if(s->packet_clock_valid && now_us<=s->last_packet_us) {
+        s->last_reason=NVT_PM_STALE_PACKET;
+        ++s->rejected[NVT_PM_STALE_PACKET];return -1;
+    }
+    s->packet_clock_valid=1;s->last_packet_us=now_us;s->last_block=raw[332];
+    if(!core->have_reference)return 0;
+    const int row0=(raw[332]-1)*10;
+    int found=0;
+    for(int i=0;i<NVT_SLOTS && found<max;++i) {
+        const struct nvt_slot *slot=&core->slots[i];
+        struct nvt_partial_template *t=&s->finger[i];
+        int reason=NVT_PM_NO_TEMPLATE;
+        if(!slot_current(t,slot)){t->valid=0;++s->rejected[reason];continue;}
+        const int row=inverse_axis(slot->y,1),col=inverse_axis(slot->x,0);
+        if(!isolated(core,i,row,col)){++s->rejected[NVT_PM_AMBIGUOUS];continue;}
+        const int cr=(row+128)/256,cc=(col+128)/256;
+        int count=0,peak=0,above=0,minr=40,maxr=-1,minc=60,maxc=-1;
+        for(int r=maxi(row0,cr-5);r<=mini(row0+9,cr+5);++r)
+            for(int c=maxi(0,cc-5);c<=mini(NVT_COLUMNS-1,cc+5);++c) {
+                const int local=(r-row0)*NVT_COLUMNS+c;
+                const unsigned off=4217u+2u*(unsigned)local;
+                const int16_t value=(int16_t)((unsigned)raw[off]|((unsigned)raw[off+1]<<8));
+                const int d=(int)value-core->reference[r*NVT_COLUMNS+c];
+                if(absi(d)>PM_MAX_DELTA){count=-1;break;}
+                if(count<0)break;
+                struct nvt_partial_sample *p=&s->sample[count++];
+                p->row=(int16_t)r;p->col=(int16_t)c;p->delta=(int16_t)d;p->weight=16;
+                if(d>peak)peak=d;
+                if(d>=NVT_NOISE_THRESHOLD) {
+                    ++above;
+                    if(r<minr)minr=r;if(r>maxr)maxr=r;
+                    if(c<minc)minc=c;if(c>maxc)maxc=c;
+                }
+            }
+        if(count<8 || peak<NVT_UP_THRESHOLD || above<3 || minr==maxr || minc==maxc) {
+            reason=NVT_PM_NO_SIGNAL;s->last_reason=reason;++s->rejected[reason];continue;
+        }
+        const int initial_x=col-t->origin_col_q8,initial_y=row-t->origin_row_q8;
+        struct fit_result best=fit_at(s,t,count,initial_x,initial_y);
+        /* Hierarchical bounded coordinate descent; 7 resolutions, <=5 moves at
+         * the first, one at later resolutions. At most89 local evaluations. */
+        const int steps[7]={256,128,64,32,16,8,4};
+        for(int level=0;level<7;++level) {
+            const int repeats=level?1:5;
+            for(int move=0;move<repeats;++move) {
+                struct fit_result winner=best;
+                for(int dr=-1;dr<=1;++dr)for(int dc=-1;dc<=1;++dc) {
+                    if(!dr && !dc)continue;
+                    const int dx=best.dx+dc*steps[level],dy=best.dy+dr*steps[level];
+                    if(absi(dx-initial_x)>PM_MAX_OFFSET || absi(dy-initial_y)>PM_MAX_OFFSET)continue;
+                    struct fit_result candidate=fit_at(s,t,count,dx,dy);
+                    if(candidate.valid && (!winner.valid || candidate.cost<winner.cost))winner=candidate;
+                }
+                if(winner.dx==best.dx && winner.dy==best.dy)break;
+                best=winner;
+            }
+        }
+        if(!best.valid)reason=NVT_PM_BAD_FIT;
+        else if(absi(best.dx-initial_x)>=PM_MAX_OFFSET ||
+                absi(best.dy-initial_y)>=PM_MAX_OFFSET)reason=NVT_PM_SEARCH_BOUND;
+        else {
+            /* Full-M learned shape, not host-provided shape. Bound the measured
+             * PM mismatch and use its actual residual in the information gate. */
+            const int rms_budget=maxi(6,best.peak/100);
+            if(best.rms_q8>rms_budget*rms_budget*256)reason=NVT_PM_BAD_FIT;
+            else if(!information_ok(s,t,count,&best)) {
+                s->presence_ids|=1u<<slot->tracking_id;
+                if(best.one_axis_valid)s->one_axis_ids|=1u<<slot->tracking_id;
+                reason=NVT_PM_NO_INFORMATION;
+            }
+            else reason=NVT_PM_ACCEPTED;
+        }
+        s->last_reason=reason;s->last_rms_q8=best.rms_q8;s->last_information=best.information;
+        if(reason!=NVT_PM_ACCEPTED){++s->rejected[reason];continue;}
+        struct nvt_contact *contact=&out[found++];
+        contact->slot=i;contact->tracking_id=slot->tracking_id;
+        contact->x=map_q8(t->origin_col_q8+best.dx,0);
+        contact->y=map_q8(t->origin_row_q8+best.dy,1);
+        contact->peak=best.peak;contact->area=above;contact->weight=peak*above;
+        ++s->accepted;
+    }
+    return found;
+}
diff --git a/device/drivers/ShengNovatekTouch/NvtPartialObservation.h b/device/drivers/ShengNovatekTouch/NvtPartialObservation.h
new file mode 100644
--- /dev/null
+++ b/device/drivers/ShengNovatekTouch/NvtPartialObservation.h
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: Apache-2.0
+#ifndef NVT_PARTIAL_OBSERVATION_H
+#define NVT_PARTIAL_OBSERVATION_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+#include "NvtTouchCore.h"
+
+/* Experimental measured-template PM extension. Integer only; no allocation.
+ * State belongs to the same controller epoch as core. The owner resets both.
+ * Feed only fresh complete accepted packets. Duplicate counter handling stays
+ * in the transport; timestamps must be strictly increasing within this state.
+ * No raw P plane is passed to ordinary-M processing. No PM-created DOWN.
+ *
+ * Fixedpoint shape learned from real M is not the Gaussian oracle experiment:
+ * residual/model error and information floors are explicit below and require
+ * real sensor calibration. No statistical hardware precision is asserted.
+ */
+#define NVT_PM_SIDE 9
+#define NVT_PM_PATCH (NVT_PM_SIDE*NVT_PM_SIDE)
+#define NVT_PM_MAX_SAMPLES 121
+enum nvt_partial_reason {
+    NVT_PM_ACCEPTED, NVT_PM_NO_TEMPLATE, NVT_PM_BAD_PACKET,
+    NVT_PM_STALE_PACKET, NVT_PM_NO_SIGNAL, NVT_PM_AMBIGUOUS,
+    NVT_PM_SEARCH_BOUND, NVT_PM_BAD_FIT, NVT_PM_NO_INFORMATION,
+    NVT_PM_REASONS
+};
+struct nvt_partial_template {
+    int valid, tracking_id, anchor_row, anchor_col;
+    int origin_row_q8, origin_col_q8;
+    int seed_peak, support;
+    int variance_x_q16, variance_y_q16, covariance_xy_q16;
+    int seed_mse_q8; // full-M continuous-shape fit, never an oracle shape
+    uint64_t generation, born_us, seed_us;
+    int16_t values[NVT_PM_PATCH]; /* actual M delta, normalized peak=1024 */
+};
+struct nvt_partial_sample {int16_t row, col, delta; uint16_t weight;};
+struct nvt_partial_state {
+    struct nvt_partial_template finger[NVT_SLOTS];
+    struct nvt_partial_sample sample[NVT_PM_MAX_SAMPLES];
+    int16_t model[NVT_PM_MAX_SAMPLES];
+    unsigned presence_ids, one_axis_ids; // quality only, never position lease renewal
+    uint64_t last_packet_us;
+    unsigned packet_clock_valid;
+    unsigned long seeded, accepted, rejected[NVT_PM_REASONS];
+    int last_reason, last_block, last_rms_q8, last_information;
+};
+void nvt_partial_reset(struct nvt_partial_state *state);
+/* After a successful full-M process, learn only complete isolated compact blobs.
+ * A failed new seed does not rewrite a good template of the same generation.
+ * A retired/reused ID invalidates its old template. */
+void nvt_partial_seed(struct nvt_partial_state *state,
+                      const struct nvt_touch_core *core,
+                      const int16_t *matrix, uint64_t now_us);
+/* -1 invalid/stale packet, otherwise number of prequalified existing-ID position
+ * observations (0 means UNKNOWN/no accepted 2D measurement, never a full UP).
+ * Root must keep packet freshness and epoch reset ownership at the transport. */
+int nvt_partial_measure(struct nvt_partial_state *state,
+                        const struct nvt_touch_core *core,
+                        const uint8_t *raw, size_t length, uint64_t now_us,
+                        struct nvt_contact *out, int max);
+#ifdef __cplusplus
+}
+#endif
+#endif
