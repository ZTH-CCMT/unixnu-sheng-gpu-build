diff --git a/device/drivers/ShengHidInput/NativeHidTouchPlan.h b/device/drivers/ShengHidInput/NativeHidTouchPlan.h
new file mode 100644
--- /dev/null
+++ b/device/drivers/ShengHidInput/NativeHidTouchPlan.h
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Pure report planning/ACK bookkeeping. No allocation, timer, I/O or OS ABI.
+#ifndef NATIVE_HID_TOUCH_PLAN_H
+#define NATIVE_HID_TOUCH_PLAN_H
+#include <stdint.h>
+#include <string.h>
+#define NHT_CONTACTS 10
+#define NHT_REPORT_BYTES (1+NHT_CONTACTS*6+1)
+struct nht_point {int id,x,y;}; // Already normalized0..32767; IDs0..255.
+struct nht_state {uint32_t sequence;unsigned count;struct nht_point point[NHT_CONTACTS];};
+struct nht_packet {unsigned char bytes[NHT_REPORT_BYTES];unsigned entries,downs,ups;struct nht_state acknowledged;};
+struct nht_plan {uint32_t sequence;unsigned count,next;struct nht_packet packet[2];};
+static inline int nht_index(const struct nht_point *p,unsigned count,int id) {for(unsigned i=0;i<count;++i)if(p[i].id==id)return (int)i;return -1;}
+static inline int nht_valid(const struct nht_point *p,unsigned count) {
+ if(count>NHT_CONTACTS || (count && !p))return 0;
+ for(unsigned i=0;i<count;++i)if(p[i].id<0 || p[i].id>255 || p[i].x<0 || p[i].x>32767 || p[i].y<0 || p[i].y>32767 || nht_index(p,i,p[i].id)>=0)return 0;
+ return 1;
+}
+static inline void nht_entry(struct nht_packet *q,const struct nht_point *p,int down) {
+ unsigned char *f=q->bytes+1+q->entries*6;f[0]=(unsigned char)(down?3:2);f[1]=(unsigned char)p->id;
+ f[2]=(unsigned char)p->x;f[3]=(unsigned char)(p->x>>8);f[4]=(unsigned char)p->y;f[5]=(unsigned char)(p->y>>8);
+ ++q->entries;if(down)q->acknowledged.point[q->acknowledged.count++]=*p,++q->downs;else ++q->ups;
+}
+// Returns packetcount0..2, or-1 for invalid input. Input/ack state never mutated.
+// If no packets are needed, caller may commit the empty snapshot's sequence.
+static inline int nht_build(const struct nht_state *ack,const struct nht_point *now,unsigned count,uint32_t sequence,struct nht_plan *plan) {
+ if(!ack || !plan || (sequence&1) || !nht_valid(ack->point,ack->count) || !nht_valid(now,count))return -1;
+ memset(plan,0,sizeof(*plan));plan->sequence=sequence;
+ if(sequence==ack->sequence)return 0;
+ unsigned removed=0;for(unsigned j=0;j<ack->count;++j)if(nht_index(now,count,ack->point[j].id)<0)++removed;
+ if(!count && !removed)return 0;
+ struct nht_packet *first=&plan->packet[0];first->bytes[0]=3;first->acknowledged.sequence=ack->sequence;
+ if(count+removed>NHT_CONTACTS) {
+  // Phase1: only old survivors DOWN plus every vanished old ID UP. Exactly the
+  // old set (<=10) fits. Do not admit new DOWN until the old UP packet succeeds.
+  for(unsigned i=0;i<count;++i)if(nht_index(ack->point,ack->count,now[i].id)>=0)nht_entry(first,&now[i],1);
+  for(unsigned j=0;j<ack->count;++j)if(nht_index(now,count,ack->point[j].id)<0)nht_entry(first,&ack->point[j],0);
+  struct nht_packet *second=&plan->packet[1];second->bytes[0]=3;second->acknowledged.sequence=sequence;
+  for(unsigned i=0;i<count;++i)nht_entry(second,&now[i],1);
+  plan->count=2;
+ } else {
+  for(unsigned i=0;i<count;++i)nht_entry(first,&now[i],1);
+  for(unsigned j=0;j<ack->count;++j)if(nht_index(now,count,ack->point[j].id)<0)nht_entry(first,&ack->point[j],0);
+  first->acknowledged.sequence=sequence;plan->count=1;
+ }
+ for(unsigned i=0;i<plan->count;++i)plan->packet[i].bytes[NHT_REPORT_BYTES-1]=(unsigned char)plan->packet[i].entries;
+ return (int)plan->count;
+}
+// API success acknowledges submission, not delivery to backboardd/UIKit. Errors
+// may be ambiguous; this stores successful API reports only, never exactly-once.
+// A caller may rebuild from this state at its next notification after failure.
+static inline int nht_commit(struct nht_state *ack,struct nht_plan *plan,unsigned index,int report_success) {
+ if(!ack || !plan || index!=plan->next || index>=plan->count || !report_success)return 0;
+ *ack=plan->packet[index].acknowledged;++plan->next;return 1;
+}
+#endif
diff --git a/device/drivers/ShengNovatekTouch/NvtCoverage.c b/device/drivers/ShengNovatekTouch/NvtCoverage.c
new file mode 100644
--- /dev/null
+++ b/device/drivers/ShengNovatekTouch/NvtCoverage.c
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "NvtCoverage.h"
+#include <string.h>
+
+static uint64_t cover_ceil_div(uint64_t n,uint64_t d) {
+    return n/d+(n%d!=0);
+}
+/* Exact ceil(Aq16*dt_us^2/(2*10^12)), avoiding the potentially overflowing
+ * three-factor product. dt<100000 and A<=UINT32_MAX:
+ * A*dt<2^49; q*dt<2^45; remainder numerator<2.2e12.
+ * Only uint64 divide/multiply is needed; no __int128 runtime operations. */
+static uint64_t cover_acceleration(uint32_t a,uint64_t dt) {
+    const uint64_t first=(uint64_t)a*dt;
+    const uint64_t q=first/UINT64_C(2000000),r=first%UINT64_C(2000000);
+    const uint64_t qdt=q*dt;
+    const uint64_t tail=(qdt%UINT64_C(1000000))*UINT64_C(2000000)+r*dt;
+    return qdt/UINT64_C(1000000)+cover_ceil_div(tail,UINT64_C(2000000000000));
+}
+static unsigned cover_low(int64_t value,unsigned maximum) {
+    if(value<=0)return 0;
+    if(value>=(int64_t)maximum*65536)return maximum;
+    return (unsigned)(value/65536);
+}
+static unsigned cover_high(int64_t value,unsigned maximum) {
+    if(value<=0)return 0;
+    if(value>=(int64_t)maximum*65536)return maximum;
+    return (unsigned)cover_ceil_div((uint64_t)value,65536);
+}
+static int cover_finish(struct nvt_coverage_result *r,int decision,int reason) {
+    r->decision=decision;r->reason=reason;return decision;
+}
+int nvt_coverage_negative(const struct nvt_coverage_policy *policy,
+                          const struct nvt_coverage_contact *contact,
+                          const struct nvt_coverage_observation *observation,
+                          struct nvt_coverage_result *result) {
+    if(!result)return NVT_COVERAGE_UNKNOWN;
+    memset(result,0,sizeof(*result));
+    if(!policy)return cover_finish(result,NVT_COVERAGE_UNKNOWN,NVT_COVERAGE_NO_POLICY);
+    if(!contact || !observation || !observation->values_le || !observation->baseline ||
+       !observation->row_count || observation->row0>=NVT_ROWS ||
+       observation->row_count>NVT_ROWS-observation->row0 ||
+       observation->value_bytes<(size_t)observation->row_count*NVT_COLUMNS*2u ||
+       contact->row_q16<0 || contact->row_q16>(NVT_ROWS-1)*65536 ||
+       contact->col_q16<0 || contact->col_q16>(NVT_COLUMNS-1)*65536)
+        return cover_finish(result,NVT_COVERAGE_UNKNOWN,NVT_COVERAGE_INVALID_INPUT);
+    result->sample_token=observation->sample_token;result->time_us=observation->time_us;
+    if(!observation->fresh || !observation->epoch_trusted ||
+       !observation->baseline_trusted || !observation->mode_trusted)
+        return cover_finish(result,NVT_COVERAGE_UNKNOWN,NVT_COVERAGE_UNTRUSTED);
+    if(contact->epoch!=observation->epoch)
+        return cover_finish(result,NVT_COVERAGE_UNKNOWN,NVT_COVERAGE_EPOCH_MISMATCH);
+    if(observation->time_us<contact->position_us)
+        return cover_finish(result,NVT_COVERAGE_UNKNOWN,NVT_COVERAGE_STALE);
+    const uint64_t dt=observation->time_us-contact->position_us;
+    result->dt_us=dt;
+    if(dt>=NVT_OBSERVATION_MAX_US)
+        return cover_finish(result,NVT_COVERAGE_UNKNOWN,NVT_COVERAGE_DEADLINE);
+    if(!policy->motion_bounds_verified || !contact->position_support_bounds_verified) {
+        result->first_row=0;result->last_row=NVT_ROWS-1;
+        result->first_col=0;result->last_col=NVT_COLUMNS-1;
+    } else {
+        const uint64_t velocity=cover_ceil_div((uint64_t)policy->vmax_q16_per_s*dt,UINT64_C(1000000));
+        const uint64_t radius=(uint64_t)contact->uncertainty_radius_q16+
+            contact->support_radius_q16+velocity+cover_acceleration(policy->amax_q16_per_s2,dt);
+        result->radius_q16=radius;
+        // Bounds stay within signed64 even for all explicit uint32 maxima.
+        result->first_row=cover_low((int64_t)contact->row_q16-(int64_t)radius,NVT_ROWS-1);
+        result->last_row=cover_high((int64_t)contact->row_q16+(int64_t)radius,NVT_ROWS-1);
+        result->first_col=cover_low((int64_t)contact->col_q16-(int64_t)radius,NVT_COLUMNS-1);
+        result->last_col=cover_high((int64_t)contact->col_q16+(int64_t)radius,NVT_COLUMNS-1);
+    }
+    const unsigned covered_last=observation->row0+observation->row_count-1;
+    if(result->first_row<observation->row0 || result->last_row>covered_last)
+        return cover_finish(result,NVT_COVERAGE_UNKNOWN,NVT_COVERAGE_INSUFFICIENT);
+    int largest=-65536;
+    for(unsigned row=result->first_row;row<=result->last_row;++row)
+        for(unsigned col=result->first_col;col<=result->last_col;++col) {
+            const size_t local=(size_t)(row-observation->row0)*NVT_COLUMNS+col,offset=local*2;
+            const unsigned raw=(unsigned)observation->values_le[offset] |
+                ((unsigned)observation->values_le[offset+1]<<8);
+            const int value=(raw&0x8000u)?(int)raw-65536:(int)raw;
+            const int delta=value-(int)observation->baseline[row*NVT_COLUMNS+col];
+            if(delta>largest)largest=delta;
+            // Existing detector noise floor: either sign can be interference
+            // or an unreliable baseline. Neither proves quiet background.
+            // This is not sufficient positive finger/contact evidence.
+            if(delta>=NVT_NOISE_THRESHOLD || delta<=-NVT_NOISE_THRESHOLD) {
+                result->largest_delta=largest;
+                return cover_finish(result,NVT_COVERAGE_SIGNAL_PRESENT,NVT_COVERAGE_SIGNAL);
+            }
+        }
+    result->largest_delta=largest;
+    return cover_finish(result,NVT_COVERAGE_COVERED_NEGATIVE,NVT_COVERAGE_NEGATIVE);
+}
diff --git a/device/drivers/ShengNovatekTouch/NvtCoverage.h b/device/drivers/ShengNovatekTouch/NvtCoverage.h
new file mode 100644
--- /dev/null
+++ b/device/drivers/ShengNovatekTouch/NvtCoverage.h
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: Apache-2.0
+#ifndef NVT_COVERAGE_H
+#define NVT_COVERAGE_H
+#include <stddef.h>
+#include <stdint.h>
+#include "NvtTouchCore.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+#define NVT_COVERAGE_Q16 UINT32_C(65536)
+struct nvt_coverage_policy {
+    /* Explicit measured/verified motion bounds; no default human speed.
+     * If false, the possible position set is the entire panel. */
+    unsigned motion_bounds_verified;
+    uint32_t vmax_q16_per_s,amax_q16_per_s2;
+};
+struct nvt_coverage_contact {
+    uint64_t epoch,position_us;
+    int32_t row_q16,col_q16;
+    /* Caller-supplied bounds enclosing E and the contact's signal support S.
+     * Scalar radii conservatively enclose arbitrary initial/support sets. */
+    uint32_t uncertainty_radius_q16,support_radius_q16;
+    /* A statistical 3sigma estimate alone is not a verified physical bound. */
+    unsigned position_support_bounds_verified;
+};
+struct nvt_coverage_observation {
+    uint64_t epoch,sample_token,time_us;
+    unsigned row0,row_count;
+    /* Actual current row_count*60 little-endian signed int16 values.
+     * No assembled raster or stale rows. baseline is the trusted full panel. */
+    const uint8_t *values_le;
+    size_t value_bytes;
+    const int16_t *baseline;
+    /* These provenance facts are owned by the packet/epoch/baseline producer. */
+    unsigned fresh,epoch_trusted,baseline_trusted,mode_trusted;
+};
+enum nvt_coverage_decision {
+    NVT_COVERAGE_UNKNOWN=0,
+    NVT_COVERAGE_COVERED_NEGATIVE=1,
+    NVT_COVERAGE_SIGNAL_PRESENT=2
+};
+enum nvt_coverage_reason {
+    NVT_COVERAGE_NO_POLICY=0,NVT_COVERAGE_INVALID_INPUT,
+    NVT_COVERAGE_UNTRUSTED,NVT_COVERAGE_EPOCH_MISMATCH,
+    NVT_COVERAGE_STALE,NVT_COVERAGE_DEADLINE,
+    NVT_COVERAGE_INSUFFICIENT,NVT_COVERAGE_SIGNAL,
+    NVT_COVERAGE_NEGATIVE
+};
+struct nvt_coverage_result {
+    int decision,reason,largest_delta;
+    unsigned first_row,last_row,first_col,last_col;
+    uint64_t dt_us,radius_q16,sample_token,time_us;
+};
+/* NULL policy is explicitly UNKNOWN. With an explicit unverified-bounds policy,
+ * U is the whole panel; a PM stripe cannot prove absence. With verified bounds:
+ * U = E (+) Ball(Vmax*dt + 0.5*Amax*dt^2), then inflate by support S.
+ * Ceil Q16 arithmetic encloses, never shrinks, the continuous set.
+ * dt>=100ms belongs to Core observation cancellation, not physical-UP proof.
+ * A result never mutates a track or sends UP. The owner checks ID/generation
+ * before consuming it, and never refreshes position time from negative data.
+ * Freshness flags/epoch are trusted caller evidence, not inferred counter rules.
+ */
+int nvt_coverage_negative(const struct nvt_coverage_policy *,
+                          const struct nvt_coverage_contact *,
+                          const struct nvt_coverage_observation *,
+                          struct nvt_coverage_result *);
+#ifdef __cplusplus
+}
+#endif
+#endif
