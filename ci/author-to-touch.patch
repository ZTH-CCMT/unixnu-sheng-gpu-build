+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef SHENG_EXPERIMENTAL_TOUCH_ENGINE_H
+#define SHENG_EXPERIMENTAL_TOUCH_ENGINE_H
+#include <stdint.h>
+extern "C" {
+#include "NvtProtocol.h"
+#include "NvtTouchCore.h"
