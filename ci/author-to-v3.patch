+
+// End only paths already recorded; retaining core slots is intentional. Passing
+// a fabricated empty frame to recordPaths would still visit those active slots.
+static void closeStalledPaths(touch_trace_row frame) {
+    if (!pathTrace.lock) return;
+    IOLockLock(pathTrace.lock);
+    if (!pathTrace.frozen) {
+        for (unsigned i = 0; i < NVT_SLOTS; ++i) {
+            auto &origin = pathTrace.origin[i];
+            if (!origin.id) continue;
+            auto end = frame;
+            end.id = origin.id;
+            end.flags |= TouchEnd;
+            end.origin_edges = origin.edges;
+            end.miss_reason = UINT8_MAX;  // Whole-stream loss, not a core missing-blob reason.
+            pathTrace.ring[pathTrace.total++ % TouchTraceCapacity] = end;
+            origin.id = 0;
+        }
+    }
+    IOLockUnlock(pathTrace.lock);
+}
+
+static void expireTouchStream(TouchLifecycle &lifetime, uint64_t nowUs, uint32_t counter) {
+    const auto action = lifetime.expire(nowUs, gScriptedDown);
+    if (action == TouchLifecycle::GuardDeferred) {
+        native_touch_stream_stats[2] = native_touch_stream_stats[2] + 1;
+        return;
+    }
+    if (action != TouchLifecycle::Release) return;
+    native_touch_stream_stats[0] = native_touch_stream_stats[0] + 1;
+    native_touch_contacts = 0;
+    const auto reports = native_touch_hid_reports;
+    if (native_touch_count) {
+        publish(0, nullptr);
+        native_touch_stream_stats[1] = native_touch_stream_stats[1] + 1;
+    }
+    touch_trace_row end = {};
+    end.counter = counter;
+    end.report_us = nowUs;
+    end.peer_distance = UINT16_MAX;
+    if (native_touch_hid_reports != reports && &native_hid_input_results) {
+        end.flags |= TouchReport;
+        end.hid_result = native_hid_input_results[6];
+    }
+    closeStalledPaths(end);
 }
 
