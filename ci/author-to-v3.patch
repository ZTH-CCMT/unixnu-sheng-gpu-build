diff --git a/device/package/TouchLifecycle.h b/device/package/TouchLifecycle.h
new file mode 100644
--- /dev/null
+++ b/device/package/TouchLifecycle.h
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef SHENG_TOUCH_LIFECYCLE_H
+#define SHENG_TOUCH_LIFECYCLE_H
+#include <stdint.h>
+
+// Publication lifetime, independent of the sensor tracker and its reference.
+// A valid pen packet proves stream liveness but says nothing about finger-up.
+// The 100 ms whole-stream guard follows xiaomi-sheng-thp 3404621; it is not a
+// finger-matrix timeout. Call only from the existing physical touch thread.
+struct TouchLifecycle {
+    enum { StallUs = 100000, GuardRetryMs = 100 };
+    enum Action { None, GuardDeferred, Release };
+    uint64_t lastValidUs = 0;
+    bool haveValid = false;
+    bool physicalActive = false;
+    bool stalled = false;
+    bool guardDeferred = false;
+
+    // Only a complete, fresh accepted type-2/4 frame qualifies, including 0x1d.
+    bool acceptValid(uint64_t nowUs) {
+        const bool recovered = stalled;
+        lastValidUs = nowUs;
+        haveValid = true;
+        stalled = false;
+        guardDeferred = false;
+        return recovered;
+    }
+    // Called after an ordinary physical set was actually published, not after
+    // scripted publication or a pending first sample suppressed by the core.
+    void published(unsigned count) { physicalActive = count != 0; }
+
+    // Zero means the original indefinite IRQ wait. Timed waits are only armed
+    // for a published physical contact. Round up; zero must never mean due.
+    unsigned waitMs(uint64_t nowUs, bool scriptedDown) const {
+        if (!haveValid || !physicalActive || stalled) return 0;
+        const uint64_t elapsed = nowUs - lastValidUs;
+        if (elapsed >= StallUs) return scriptedDown ? GuardRetryMs : 1;
+        return static_cast<unsigned>((StallUs - elapsed + 999) / 1000);
+    }
+    Action expire(uint64_t nowUs, bool scriptedDown) {
+        if (!haveValid || !physicalActive || stalled || nowUs - lastValidUs < StallUs) return None;
+        if (scriptedDown) {
+            if (guardDeferred) return None;
+            guardDeferred = true;
+            return GuardDeferred;
+        }
+        // Consume the stall even if the shared output was already released by
+        // the script. No slot, filter, calibration, or reference is reset here.
+        physicalActive = false;
+        stalled = true;
+        guardDeferred = false;
+        return Release;
+    }
+};
+#endif
