diff --git a/device/package/TouchEvidenceWire.h b/device/package/TouchEvidenceWire.h
new file mode 100644
--- /dev/null
+++ b/device/package/TouchEvidenceWire.h
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef SHENG_TOUCH_EVIDENCE_WIRE_H
+#define SHENG_TOUCH_EVIDENCE_WIRE_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+namespace TouchEvidenceWire {
+enum { MaxBlob = 131072, RawChunk = 4096, RowCapacity = 12288 };
+struct Writer {
+    uint8_t *data; size_t cap, size; bool ok;
+    Writer(uint8_t *d, size_t c):data(d),cap(c),size(0),ok(d != NULL) {}
+    void bytes(const void *p, size_t n) {
+        if (!ok || !p || size > cap || n > cap-size) {ok=false;return;}
+        memcpy(data+size,p,n);size+=n;
+    }
+    void u8(uint8_t n) {bytes(&n,1);}
+    void u16(uint16_t n) {u8(n & 255);u8(n >> 8);}
+    void u32(uint32_t n) {u16(n & 65535);u16(n >> 16);}
+    void u64(uint64_t n) {u32((uint32_t)n);u32((uint32_t)(n >> 32));}
+    void i32(int32_t n) {u32((uint32_t)n);}
+    void i64(int64_t n) {u64((uint64_t)n);}
+};
+// This CRC protects the saved evidence file. It is NOT a sensor payload CRC.
+static inline uint32_t crc32(const uint8_t *data,size_t bytes) {
+    uint32_t c=0xffffffffu;
+    for(size_t i=0;i<bytes;++i) {c^=data[i];for(unsigned b=0;b<8;++b)c=(c>>1)^(0xedb88320u & (0u-(c&1u)));}
+    return c^0xffffffffu;
+}
+static inline bool append(char *out,size_t cap,size_t &at,const char *s,size_t n) {
+    if(!out || at>=cap || n>=cap-at)return false;
+    memcpy(out+at,s,n);at+=n;out[at]=0;return true;
+}
+static inline bool number(char *out,size_t cap,size_t &at,uint64_t value,unsigned base=10,unsigned width=0) {
+    if((base!=10 && base!=16) || width>32)return false;
+    char digits[32];size_t n=0;
+    do {unsigned d=(unsigned)(value%base);digits[n++]=(char)(d<10?'0'+d:'a'+d-10);value/=base;} while(value && n<sizeof digits);
+    while(n<width)digits[n++]='0';
+    while(n)if(!append(out,cap,at,&digits[--n],1))return false;
+    return true;
+}
+static inline bool literal(char *out,size_t cap,size_t &at,const char *s) {return append(out,cap,at,s,strlen(s));}
+// Called only by the existing log writer, after an immutable snapshot is ready.
+// Slot modulo repeats every chunk; later 32MiB captures can recover a complete blob.
+static inline size_t rows(char *out,size_t cap,const uint8_t *blob,size_t total,uint32_t crc,uint32_t slot,uint64_t bootId) {
+    if(!out || cap<RowCapacity || !blob || !total || total>MaxBlob)return 0;
+    const size_t chunks=(total+RawChunk-1)/RawChunk;
+    const size_t off=(slot%chunks)*RawChunk, n=total-off<(size_t)RawChunk?total-off:(size_t)RawChunk;
+    size_t at=0;out[0]=0;
+    if(!literal(out,cap,at,"[touch evidence] format=TEV1 boot=") || !number(out,cap,at,bootId,16,16) ||
+       !literal(out,cap,at," generation=1 total=") || !number(out,cap,at,total) ||
+       !literal(out,cap,at," crc32=") || !number(out,cap,at,crc,16,8) ||
+       !literal(out,cap,at," off=") || !number(out,cap,at,off) ||
+       !literal(out,cap,at," bytes=") || !number(out,cap,at,n) || !literal(out,cap,at,"\n"))return 0;
+    static const char hex[]="0123456789abcdef";
+    for(size_t j=0;j<n;j+=128) {
+        size_t len=n-j<128?n-j:128;
+        if(!literal(out,cap,at,"TEV1 off=") || !number(out,cap,at,off+j) || !literal(out,cap,at," hex="))return 0;
+        for(size_t k=0;k<len;++k) {
+            uint8_t b=blob[off+j+k];char pair[2]={hex[b>>4],hex[b&15]};
+            if(!append(out,cap,at,pair,2))return 0;
+        }
+        if(!append(out,cap,at,"\n",1))return 0;
+    }
+    return at;
+}
+}
+#endif
diff --git a/device/package/TouchLifecycle.h b/device/package/TouchLifecycle.h
new file mode 100644
--- /dev/null
+++ b/device/package/TouchLifecycle.h
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef SHENG_TOUCH_LIFECYCLE_H
+#define SHENG_TOUCH_LIFECYCLE_H
+#include <stdint.h>
+
+// Publication lifetime, independent of the sensor tracker and its reference.
+// A valid pen packet proves stream liveness but says nothing about finger-up.
+// The 100 ms whole-stream guard follows xiaomi-sheng-thp 3404621; it is not a
+// finger-matrix timeout. Call only from the existing physical touch thread.
+struct TouchLifecycle {
+    enum { StallUs = 100000, GuardRetryMs = 100 };
+    enum Action { None, GuardDeferred, Release };
+    uint64_t lastValidUs = 0;
+    bool haveValid = false;
+    bool physicalActive = false;
+    bool stalled = false;
+    bool guardDeferred = false;
+
+    // Only a complete, fresh accepted type-2/4 frame qualifies, including 0x1d.
+    bool acceptValid(uint64_t nowUs) {
+        const bool recovered = stalled;
+        lastValidUs = nowUs;
+        haveValid = true;
+        stalled = false;
+        guardDeferred = false;
+        return recovered;
+    }
+    // Called after an ordinary physical set was actually published, not after
+    // scripted publication or a pending first sample suppressed by the core.
+    void published(unsigned count) { physicalActive = count != 0; }
+
+    // Zero means the original indefinite IRQ wait. Timed waits are only armed
+    // for a published physical contact. Round up; zero must never mean due.
+    unsigned waitMs(uint64_t nowUs, bool scriptedDown) const {
+        if (!haveValid || !physicalActive || stalled) return 0;
+        const uint64_t elapsed = nowUs - lastValidUs;
+        if (elapsed >= StallUs) return scriptedDown ? GuardRetryMs : 1;
+        return static_cast<unsigned>((StallUs - elapsed + 999) / 1000);
+    }
+    Action expire(uint64_t nowUs, bool scriptedDown) {
+        if (!haveValid || !physicalActive || stalled || nowUs - lastValidUs < StallUs) return None;
+        if (scriptedDown) {
+            if (guardDeferred) return None;
+            guardDeferred = true;
+            return GuardDeferred;
+        }
+        // Consume the stall even if the shared output was already released by
+        // the script. No slot, filter, calibration, or reference is reset here.
+        physicalActive = false;
+        stalled = true;
+        guardDeferred = false;
+        return Release;
+    }
+};
+#endif
