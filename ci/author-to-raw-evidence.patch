diff --git a/device/package/TouchEvidenceSerialize.h b/device/package/TouchEvidenceSerialize.h
new file mode 100644
--- /dev/null
+++ b/device/package/TouchEvidenceSerialize.h
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef SHENG_TOUCH_EVIDENCE_SERIALIZE_H
+#define SHENG_TOUCH_EVIDENCE_SERIALIZE_H
+#include "TouchRawEvidence.h"
+#include "TouchEvidenceWire.h"
+namespace TouchEvidenceSerialize {
+enum { Version=1, HeaderBytes=136, SampleBytes=12391, MetadataBytes=17, MaximumBytes=58404 };
+static inline bool count(uint8_t n) {return n<=touch_raw_evidence::Slots;}
+static inline bool result(int16_t n) {return n>=touch_raw_evidence::MNotCalled && n<=touch_raw_evidence::Slots;}
+static inline bool kind(uint8_t n) {return n==touch_raw_evidence::Ordinary || n==touch_raw_evidence::SpecialP;}
+static inline bool type(uint8_t n) {return n==2 || n==4;}
+// Caller must obtain Frozen through Collector::frozenAcquire(). Do not pass live
+// storage. Validating freeze_reason is not a substitute for acquire publication.
+static inline size_t serialize(const touch_raw_evidence::Frozen &f,uint8_t *out,size_t cap) {
+    using namespace touch_raw_evidence;
+    if(!out || f.schema_version!=Version || f.valid_mask>15 || f.metadata_count>MetadataCapacity ||
+       (f.freeze_reason!=Deadline && f.freeze_reason!=MetadataFull))return 0;
+    size_t samples=0;
+    for(unsigned j=0;j<Samples;++j)if(f.valid_mask&(1u<<j)) {
+        const Sample &s=f.samples[j];++samples;
+        if(s.selection!=j || !kind(s.kind) || !type(s.type) || !result(s.m_result) ||
+           s.flags> NoEmptyObserved || s.have_reference>1 || !count(s.active_slot_count) ||
+           !count(s.pre_published_count) || !count(s.post_published_count) || !count(s.out_count))return 0;
+    }
+    for(unsigned j=0;j<f.metadata_count;++j) {
+        const Metadata &m=f.metadata[j];
+        if(!kind(m.kind) || !type(m.type) || !result(m.m_result) ||
+           !count(m.last_published_count) || !count(m.active_slot_count))return 0;
+    }
+    const size_t total=HeaderBytes+samples*SampleBytes+(size_t)f.metadata_count*MetadataBytes;
+    if(total>MaximumBytes || total>TouchEvidenceWire::MaxBlob || cap<total)return 0;
+    TouchEvidenceWire::Writer w(out,cap);
+    w.bytes("TEVRAW01",8);w.u32(Version);w.u32((uint32_t)total);w.u32(f.valid_mask);
+    w.u32(f.metadata_count);w.u32(f.freeze_reason);w.u32(40);w.u32(60);w.u32(Nodes);
+    w.u32(RawBytes);w.u32(PeekBytes);w.u32(Slots);w.u32(Samples);
+    w.u64(f.arm_time_us);w.u64(f.first_event_us);w.u64(f.last_event_us);w.u64(f.freeze_time_us);
+    w.u64(f.trigger_time_us);w.u64(f.trigger_record_sequence);w.u64(f.observed_frames);
+    w.u64(f.skipped_before_arm);w.u64(f.skipped_unseeded);w.u64(f.rejected_calls);
+    for(unsigned j=0;j<Samples;++j)if(f.valid_mask&(1u<<j)) {
+        const Sample &s=f.samples[j];
+        w.u64(s.record_sequence);w.u64(s.time_us);w.u16(s.counter);w.u16((uint16_t)s.m_result);
+        w.u8(s.type);w.u8(s.data_type);w.u8(s.kind);w.u8(s.selection);w.u8(s.flags);
+        w.u8(s.have_reference);w.u8(s.active_slot_count);w.u8(s.pre_published_count);
+        w.u8(s.post_published_count);w.u8(s.out_count);
+        w.bytes(s.raw,RawBytes);w.bytes(s.peek,PeekBytes);
+        for(unsigned k=0;k<Nodes;++k)w.u16((uint16_t)s.reference[k]);
+        for(unsigned k=0;k<Slots;++k) {
+            const SlotState &slt=s.pre_slots[k];
+            w.i64(slt.active);w.i64(slt.tracking_id);w.i64(slt.age);w.i64(slt.x);w.i64(slt.y);
+            w.i64(slt.rx);w.i64(slt.ry);w.i64(slt.fx);w.i64(slt.fy);w.i64(slt.vx);w.i64(slt.vy);
+            w.i64(slt.dx);w.i64(slt.dy);w.i64(slt.missed);w.i64(slt.miss_reason);
+        }
+        for(unsigned k=0;k<Slots;++k) {
+            const ContactState &c=s.out[k];w.i64(c.slot);w.i64(c.tracking_id);w.i64(c.x);w.i64(c.y);
+            w.i64(c.peak);w.i64(c.area);w.i64(c.weight);
+        }
+    }
+    for(unsigned j=0;j<f.metadata_count;++j) {
+        const Metadata &m=f.metadata[j];w.u64(m.time_us);w.u16(m.counter);w.u16((uint16_t)m.m_result);
+        w.u8(m.type);w.u8(m.data_type);w.u8(m.kind);w.u8(m.last_published_count);w.u8(m.active_slot_count);
+    }
+    return w.ok && w.size==total?w.size:0;
+}
+static_assert(HeaderBytes+(size_t)touch_raw_evidence::Samples*SampleBytes+
+    (size_t)touch_raw_evidence::MetadataCapacity*MetadataBytes==MaximumBytes,"bounded wire size");
+} // namespace TouchEvidenceSerialize
+#endif
