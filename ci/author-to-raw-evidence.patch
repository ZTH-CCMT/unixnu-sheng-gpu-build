+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef SHENG_TOUCH_RAW_EVIDENCE_H
+#define SHENG_TOUCH_RAW_EVIDENCE_H
+#include <stddef.h>
+#include <stdint.h>
+
+// Diagnostic evidence only. This header never calls the core, publishes input,
+// sleeps, accesses hardware, or allocates. The caller owns one Storage and uses
+// one producer thread. Do not use prepare's return value to gate live processing.
+namespace touch_raw_evidence {
+enum { RawBytes=5417, PeekBytes=32, Nodes=2400, Slots=12, Samples=4, MetadataCapacity=512 };
+enum Kind : uint8_t { Ordinary=1, SpecialP=2 };
+enum Selection : uint8_t { FirstP=0, FirstPositiveM=1, FollowingM=2, FirstEmptyM=3 };
+enum SampleFlag : uint8_t { NoEmptyObserved=1 };
+enum FreezeReason : uint32_t { NotFrozen=0, Deadline=1, MetadataFull=2 };
+enum Prepared { Ignored, CapturedP, AwaitingM };
+enum { MNotCalled=-2 };
+static const uint64_t WindowUs=2000000;
+
+// Fixed-width field-by-field projection of nvt_slot; no target ABI/long copy.
+struct SlotState {
+    int64_t active, tracking_id, age, x, y, rx, ry;
+    int64_t fx, fy, vx, vy, dx, dy, missed, miss_reason;
+};
+struct ContactState { int64_t slot, tracking_id, x, y, peak, area, weight; };
+struct FrameInfo {
+    uint64_t time_us;
+    uint16_t counter;
+    uint8_t type, data_type;
+    uint8_t last_published_count; // Actual producer set, not HID acknowledgement.
+};
+struct Metadata {
+    uint64_t time_us;
+    uint16_t counter;
+    int16_t m_result; // M core result; -2 means no core call for P.
+    uint8_t type, data_type, kind, last_published_count, active_slot_count;
+};
+struct Sample {
+    uint64_t record_sequence, time_us;
+    uint16_t counter;
+    int16_t m_result;
+    uint8_t type, data_type, kind, selection, flags;
+    uint8_t have_reference, active_slot_count, pre_published_count, post_published_count, out_count;
+    uint8_t raw[RawBytes], peek[PeekBytes];
+    int16_t reference[Nodes]; // Before this frame's core call.
+    SlotState pre_slots[Slots];
+    ContactState out[Slots]; // After this frame's core call; zero for P.
+};
+struct Frozen {
+    uint32_t schema_version, valid_mask, metadata_count, freeze_reason;
+    uint64_t arm_time_us, first_event_us, last_event_us, freeze_time_us, trigger_time_us, trigger_record_sequence;
+    uint64_t observed_frames, skipped_before_arm, skipped_unseeded, rejected_calls;
+    Sample samples[Samples];
+    Metadata metadata[MetadataCapacity];
+};
+// Pending pre-state is internal, not part of the exported Frozen structure.
+struct Storage { Frozen frozen; Sample pending; };
+
+class Collector {
+    Storage *storage_=nullptr;
+    uint32_t ready_=0;
+    bool configured_=false, enabled_=false, pending_=false, pending_snapshot_=false, triggered_=false;
+    uint64_t sequence_=0, last_seen_=0;
+    bool have_seen_=false;
+    static void clear(void *p,size_t n) {
+        uint8_t *b=static_cast<uint8_t *>(p);
+        for(size_t i=0;i<n;++i)b[i]=0;
+    }
+    bool live() const {return enabled_ && __atomic_load_n(&ready_,__ATOMIC_RELAXED)==0;}
+    bool due(uint64_t now) const {
+        return triggered_ && now>=storage_->frozen.trigger_time_us &&
+            now-storage_->frozen.trigger_time_us>=WindowUs;
+    }
+    bool reject() {if(live())++storage_->frozen.rejected_calls;return false;}
+    void finish(FreezeReason why,uint64_t nowUs) {
+        if(!live())return;
+        storage_->frozen.freeze_reason=why;
+        storage_->frozen.freeze_time_us=nowUs;
+        pending_=false;
+        // No storage fields may be written after this publication.
+        __atomic_store_n(&ready_,1u,__ATOMIC_RELEASE);
+    }
+    template<class Slot> void snapshot(Sample &s,const uint8_t *raw,const uint8_t *peek,
+        const int16_t *reference,const Slot *slots,const FrameInfo &f,Kind kind) {
+        clear(&s,sizeof(s));
+        s.record_sequence=sequence_;s.time_us=f.time_us;s.counter=f.counter;
+        s.type=f.type;s.data_type=f.data_type;s.kind=kind;s.have_reference=1;
+        s.pre_published_count=f.last_published_count;s.post_published_count=f.last_published_count;
+        s.m_result=MNotCalled;
+        for(size_t i=0;i<RawBytes;++i)s.raw[i]=raw[i];
+        for(size_t i=0;i<PeekBytes;++i)s.peek[i]=peek[i];
+        for(size_t i=0;i<Nodes;++i)s.reference[i]=reference[i];
+        for(size_t i=0;i<Slots;++i) {
+            SlotState &d=s.pre_slots[i];const Slot &a=slots[i];
+            d.active=a.active;d.tracking_id=a.tracking_id;d.age=a.age;d.x=a.x;d.y=a.y;
+            d.rx=a.rx;d.ry=a.ry;d.fx=a.fx;d.fy=a.fy;d.vx=a.vx;d.vy=a.vy;
+            d.dx=a.dx;d.dy=a.dy;d.missed=a.missed;d.miss_reason=a.miss_reason;
+            if(a.active)++s.active_slot_count;
+        }
+    }
+    void latch(Selection which,uint8_t flags=0) {
+        Frozen &f=storage_->frozen;
+        if(f.valid_mask&(1u<<which))return;
+        f.samples[which]=storage_->pending;
+        f.samples[which].selection=which;f.samples[which].flags=flags;
+        f.valid_mask|=1u<<which;
+    }
+    void append(const Sample &s,int result,uint8_t published) {
+        Frozen &f=storage_->frozen;
+        if(!triggered_)return;
+        if(f.metadata_count>=MetadataCapacity){finish(MetadataFull,s.time_us);return;}
+        Metadata &m=f.metadata[f.metadata_count++];
+        m.time_us=s.time_us;m.counter=s.counter;m.m_result=static_cast<int16_t>(result);
+        m.type=s.type;m.data_type=s.data_type;m.kind=s.kind;
+        m.last_published_count=published;m.active_slot_count=s.active_slot_count;
+        if(f.metadata_count==MetadataCapacity)finish(MetadataFull,s.time_us);
+    }
+public:
+    // Configure once. Disabled calls do not read/write the supplied Storage.
+    bool configure(bool enabled,Storage *storage,uint64_t armAtUs) {
+        if(configured_)return false;
+        configured_=true;
+        if(!enabled)return true;
+        if(!storage)return false;
+        storage_=storage;enabled_=true;
+        clear(storage_,sizeof(*storage_));
+        storage_->frozen.schema_version=1;storage_->frozen.arm_time_us=armAtUs;
+        return true;
+    }
+    // Caller has already accepted a complete fresh full-frame header/type2or4.
+    // No payload/CRC correctness is claimed. haveReference=false is skipped:
+    // this collector deliberately has no 72-frame startup checkpoint.
+    template<class Slot> Prepared prepare(const uint8_t *raw,size_t rawLength,
+        const uint8_t *peek,size_t peekLength,const int16_t *reference,size_t referenceNodes,
+        const Slot *slots,size_t slotCount,bool haveReference,const FrameInfo &info) {
+        if(!live())return Ignored;
+        Frozen &f=storage_->frozen;
+        if(info.time_us<f.arm_time_us){++f.skipped_before_arm;return Ignored;}
+        if(pending_){reject();return Ignored;}
+        if(have_seen_ && info.time_us<last_seen_){reject();return Ignored;}
+        if(!haveReference){++f.skipped_unseeded;return Ignored;}
+        if(!raw || rawLength!=RawBytes || !peek || peekLength!=PeekBytes ||
+            !reference || referenceNodes!=Nodes || !slots || slotCount!=Slots ||
+            (info.type!=2 && info.type!=4) || info.last_published_count>Slots) {
+            reject();return Ignored;
+        }
+        have_seen_=true;last_seen_=info.time_us;
+        ++sequence_;++f.observed_frames;
+        if(f.observed_frames==1)f.first_event_us=info.time_us;
+        f.last_event_us=info.time_us;
+        const Kind kind=info.data_type==0x1d?SpecialP:Ordinary;
+        if(kind==SpecialP) {
+            // Use pending scratch only when latching the first P. No core call.
+            Sample &s=storage_->pending;
+            if(!(f.valid_mask&(1u<<FirstP))) {
+                snapshot(s,raw,peek,reference,slots,info,kind);latch(FirstP);
+            } else {
+                s.record_sequence=sequence_;s.time_us=info.time_us;s.counter=info.counter;
+                s.type=info.type;s.data_type=info.data_type;s.kind=kind;
+                s.active_slot_count=0;
+                for(size_t i=0;i<Slots;++i)if(slots[i].active)++s.active_slot_count;
+            }
+            append(s,MNotCalled,info.last_published_count);
+            if(live() && due(info.time_us))finish(Deadline,info.time_us);
+            return CapturedP;
+        }
+        pending_=true;
+        pending_snapshot_=(f.valid_mask&14u)!=14u;
+        Sample &s=storage_->pending;
+        if(pending_snapshot_)snapshot(s,raw,peek,reference,slots,info,kind);
+        else {
+            s.record_sequence=sequence_;s.time_us=info.time_us;s.counter=info.counter;
+            s.type=info.type;s.data_type=info.data_type;s.kind=kind;
+            s.active_slot_count=0;
+            for(size_t i=0;i<Slots;++i)if(slots[i].active)++s.active_slot_count;
+        }
+        return AwaitingM;
+    }
+    // Call after the ordinary core call and actual normal publication decision.
+    // lastPublishedCount is the actual shared producer count, not an assumed n.
+    // This method never publishes, alters core state, or invents an empty set.
+    template<class Contact> bool after(int n,const Contact *out,size_t available,
+        uint8_t lastPublishedCount) {
+        if(!live())return false;
+        if(!pending_)return reject();
+        pending_=false;
+        if(n< -1 || n>Slots || (n>0 && (!out || available<static_cast<size_t>(n))) ||
+            lastPublishedCount>Slots)return reject();
+        Sample &s=storage_->pending;Frozen &f=storage_->frozen;
+        s.m_result=static_cast<int16_t>(n);s.post_published_count=lastPublishedCount;
+        s.out_count=n>0?static_cast<uint8_t>(n):0;
+        if(pending_snapshot_ && n>0)for(int i=0;i<n;++i) {
+            const Contact &a=out[i];ContactState &d=s.out[i];
+            d.slot=a.slot;d.tracking_id=a.tracking_id;d.x=a.x;d.y=a.y;
+            d.peak=a.peak;d.area=a.area;d.weight=a.weight;
+        }
+        if(n>0 && !triggered_) {
+            triggered_=true;f.trigger_time_us=s.time_us;f.trigger_record_sequence=s.record_sequence;
+            latch(FirstPositiveM);
+        } else if(triggered_ && s.record_sequence>f.trigger_record_sequence) {
+            if(pending_snapshot_)latch(FollowingM);
+        }
+        if(triggered_ && !(f.valid_mask&(1u<<FirstEmptyM)) && n>=0) {
+            if(n==0)latch(FirstEmptyM);
+            else if(due(s.time_us))latch(FirstEmptyM,NoEmptyObserved);
+        }
+        append(s,n,lastPublishedCount);
+        if(live() && due(s.time_us))finish(Deadline,s.time_us);
+        return true;
+    }
+    // Invoke only from an existing producer-thread event/guard. No new wakeups.
+    void guard(uint64_t nowUs) {
+        if(!live() || pending_)return;
+        if(have_seen_ && nowUs<last_seen_){reject();return;}
+        if(due(nowUs))finish(Deadline,nowUs);
+    }
+    const Frozen *frozenAcquire() const {
+        return __atomic_load_n(&ready_,__ATOMIC_ACQUIRE)?&storage_->frozen:nullptr;
+    }
+};
+static_assert(sizeof(Storage)+sizeof(Collector)<=128u*1024u,"evidence budget");
+} // namespace touch_raw_evidence
+#endif
